generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum UserRole {
  USER
  BUSINESS
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING
}

enum SessionRevokeReason {
  LOGOUT
  REUSE_DETECTED
  ADMIN_REVOKED
  PASSWORD_CHANGE
}

enum MediaStorageProvider {
  LOCAL
  S3
}

enum MediaResourceType {
  TRADE_POST
  TRADE_REVIEW
  USER_AVATAR
  BUSINESS_APPLICATION
  ABOUT
  TEMPLE
  SPECIALTY
  HISTORICAL_SITE
  AGRICULTURE
  OCOP
  CRAFT_VILLAGE
  CUISINE
  FESTIVAL
  EXPERIENCE_TOUR
  FEEDBACK_CHANNEL
  FEEDBACK_TICKET
  MAP_PLACE
  CONTACT
  NEWS_ARTICLE
}

enum TempleType {
  DINH
  DEN
  CHUA
  MIEU
}

enum SpecialtyCategory {
  MON_AN
  TRAI_CAY
  QUA_MANG_VE
}

enum HistoricalSiteRank {
  CAP_QUOC_GIA
  CAP_TINH
  CHUA_XEP_HANG
}

enum AgricultureCategory {
  CAY_TRONG_CHU_LUC
  CHAN_NUOI
  THUY_LOI
  MO_HINH_SAN_XUAT
}

enum OcopCategory {
  THUC_PHAM
  DO_UONG
  NONG_SAN_TUOI
  SAN_PHAM_CHE_BIEN
}

enum OcopRating {
  THREE
  FOUR
  FIVE
}

enum CraftVillageCategory {
  THU_CONG_TRUYEN_THONG
  CHE_BIEN_NONG_SAN
  DICH_VU_TRAI_NGHIEM
  SAN_PHAM_GIA_DINH
}

enum CuisineCategory {
  MON_NUOC
  MON_NUONG
  MON_CUON
  AN_VAT
  MON_CHAY
}

enum FestivalCategory {
  LE_TRUYEN_THONG
  VAN_HOA_CONG_DONG
  THE_THAO_VUI_CHOI
  SU_KIEN_NONG_SAN
}

enum ExperienceTourCategory {
  NUA_NGAY
  MOT_NGAY
  GIA_DINH
  HOC_SINH
  NONG_NGHIEP
}

enum FeedbackChannelCategory {
  GOP_Y_CHUNG
  PHAN_ANH_HA_TANG
  DICH_VU_CONG
  DU_LICH
  MINI_APP
}

enum FeedbackTicketStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum FeedbackMessageSenderRole {
  USER
  ADMIN
}

enum MapPlaceCategory {
  HANH_CHINH
  DU_LICH
  DI_TICH
  AM_THUC
  DICH_VU
}

enum MapLocationSource {
  MAP_PLACE
  CUISINE
  TEMPLE
  HISTORICAL_SITE
}

enum MapLocationStatus {
  PENDING
  RESOLVED
  UNRESOLVED
  FAILED
}

enum ContactCategory {
  HANH_CHINH
  KHAN_CAP
  DU_LICH
  NONG_NGHIEP
  PHAN_ANH
}

enum NewsCategory {
  THONG_BAO
  HOAT_DONG_XA
  DU_LICH
  NONG_NGHIEP
  CHUYEN_DOI_SO
}

enum BusinessApplicantType {
  INDIVIDUAL
  ORGANIZATION
}

// Loại hình của tài khoản được đăng tin giao thương. Quyết định form đăng ký
// (trường + giấy tờ bắt buộc) và loại tin được phép đăng (xem
// business-type.config.ts).
enum BusinessType {
  TEMPLE_MANAGEMENT // Ban quản lý đền/miếu — chỉ đăng tin phi lợi nhuận
  RESTAURANT // Nhà hàng – quán ăn
  ACCOMMODATION // Khách sạn – nhà nghỉ – homestay
  GARDEN // Chủ vườn – nhà vườn
  GENERAL // Hộ kinh doanh / doanh nghiệp khác
}

enum BusinessApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BusinessDocumentType {
  IDENTITY_FRONT
  IDENTITY_BACK
  BUSINESS_LICENSE
  TAX_DOCUMENT
  OTHER
  MANAGEMENT_DECISION // Văn bản xác nhận / quyết định công nhận Ban quản lý
  FOOD_SAFETY_CERTIFICATE // Giấy chứng nhận cơ sở đủ điều kiện ATTP
  SECURITY_CERTIFICATE // Giấy chứng nhận đủ điều kiện về ANTT
  LAND_USE_CERTIFICATE // Giấy chứng nhận quyền sử dụng đất
}

enum TradePostPriceType {
  FIXED
  NEGOTIABLE
  CONTACT
}

enum TradePostPurpose {
  COMMERCIAL // Có lợi nhuận
  NON_PROFIT // Phi lợi nhuận — không có giá
}

enum TradePostStatus {
  DRAFT
  PENDING
  PUBLISHED
  HIDDEN
  REJECTED
  EXPIRED
  ARCHIVED
}

enum TradeReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

enum TradePostEventType {
  VIEW
  CONTACT_PHONE
  CONTACT_ZALO
  SHARE
  SAVE
}

// Content sections a ContentReview can target (see content-review-targets.ts).
enum ContentReviewTargetType {
  TEMPLE
  SPECIALTY
  HISTORICAL_SITE
  AGRICULTURE
  CRAFT_VILLAGE
  CUISINE
  FESTIVAL
  EXPERIENCE_TOUR
}

enum ContentReviewStatus {
  PUBLISHED
  HIDDEN
}

// ---------- Core / Auth ----------

model User {
  id           String        @id @default(uuid())
  zaloId       String?       @unique
  phone        String?       @unique
  email        String?       @unique
  displayName  String
  avatarUrl    String?
  passwordHash String?
  role         UserRole      @default(USER)
  // Set when a business application is approved; null = GENERAL.
  businessType BusinessType?
  status       UserStatus    @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  authSessions                  AuthSession[]
  tradePostsOwned               TradePost[]           @relation("TradePostOwner")
  tradePostsApproved            TradePost[]           @relation("TradePostApprover")
  tradeReviews                  TradeReview[]
  contentReviews                ContentReview[]
  contentReviewsReplied         ContentReview[]       @relation("ContentReviewReplier")
  mediaUploads                  Media[]
  auditLogs                     AuditLog[]
  businessApplicationsSubmitted BusinessApplication[] @relation("BusinessApplicationSubmitter")
  businessApplicationsReviewed  BusinessApplication[] @relation("BusinessApplicationReviewer")
  businessApplicationAccount    BusinessApplication?  @relation("BusinessApplicationAccount")
  aboutPagesCreated             AboutPage[]           @relation("AboutPageCreator")
  aboutPagesUpdated             AboutPage[]           @relation("AboutPageUpdater")
  aboutPagesPublished           AboutPage[]           @relation("AboutPagePublisher")
  aboutRevisionsPublished       AboutRevision[]       @relation("AboutRevisionPublisher")
  templesCreated                Temple[]              @relation("TempleCreator")
  templesUpdated                Temple[]              @relation("TempleUpdater")
  specialtiesCreated            Specialty[]           @relation("SpecialtyCreator")
  specialtiesUpdated            Specialty[]           @relation("SpecialtyUpdater")
  historicalSitesCreated        HistoricalSite[]      @relation("HistoricalSiteCreator")
  historicalSitesUpdated        HistoricalSite[]      @relation("HistoricalSiteUpdater")
  agricultureItemsCreated       AgricultureItem[]     @relation("AgricultureItemCreator")
  agricultureItemsUpdated       AgricultureItem[]     @relation("AgricultureItemUpdater")
  ocopProductsCreated           OcopProduct[]         @relation("OcopProductCreator")
  ocopProductsUpdated           OcopProduct[]         @relation("OcopProductUpdater")
  craftVillagesCreated          CraftVillage[]        @relation("CraftVillageCreator")
  craftVillagesUpdated          CraftVillage[]        @relation("CraftVillageUpdater")
  cuisineItemsCreated           CuisineItem[]         @relation("CuisineItemCreator")
  cuisineItemsUpdated           CuisineItem[]         @relation("CuisineItemUpdater")
  festivalsCreated              Festival[]            @relation("FestivalCreator")
  festivalsUpdated              Festival[]            @relation("FestivalUpdater")
  experienceToursCreated        ExperienceTour[]      @relation("ExperienceTourCreator")
  experienceToursUpdated        ExperienceTour[]      @relation("ExperienceTourUpdater")
  feedbackChannelsCreated       FeedbackChannel[]     @relation("FeedbackChannelCreator")
  feedbackChannelsUpdated       FeedbackChannel[]     @relation("FeedbackChannelUpdater")
  feedbackTicketsHandled        FeedbackTicket[]      @relation("FeedbackTicketHandler")
  feedbackTicketsSubmitted      FeedbackTicket[]      @relation("FeedbackTicketSubmitter")
  feedbackMessagesSent          FeedbackMessage[]     @relation("FeedbackMessageSender")
  mapPlacesCreated              MapPlace[]            @relation("MapPlaceCreator")
  mapPlacesUpdated              MapPlace[]            @relation("MapPlaceUpdater")
  contactsCreated               Contact[]             @relation("ContactCreator")
  contactsUpdated               Contact[]             @relation("ContactUpdater")
  newsArticlesCreated           NewsArticle[]         @relation("NewsArticleCreator")
  newsArticlesUpdated           NewsArticle[]         @relation("NewsArticleUpdater")
  tradePostCategoriesCreated    TradePostCategory[]   @relation("TradePostCategoryCreator")
  tradePostCategoriesUpdated    TradePostCategory[]   @relation("TradePostCategoryUpdater")
  tradePostEvents               TradePostEvent[]      @relation("TradePostEventUser")
  savedTradePosts               SavedTradePost[]
  tradeConversationsAsCustomer  TradeConversation[]   @relation("TradeConversationCustomer")
  tradeConversationsAsOwner     TradeConversation[]   @relation("TradeConversationOwner")
  tradeMessagesSent             TradeMessage[]        @relation("TradeMessageSender")
  notifications                 Notification[]
  harvestBatches                HarvestBatch[]

  @@index([role])
}

// Refresh-token rotation with reuse detection: one row per issuance,
// chained via familyId. Presenting an already-replaced token means the
// token was stolen/replayed -> revoke the whole family.
model AuthSession {
  id                String               @id @default(uuid())
  familyId          String
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash  String
  userAgent         String?
  ipAddress         String?
  issuedAt          DateTime             @default(now())
  expiresAt         DateTime
  replacedAt        DateTime?
  replacedByTokenId String?              @unique
  replacedBy        AuthSession?         @relation("SessionRotation", fields: [replacedByTokenId], references: [id])
  rotatedFrom       AuthSession?         @relation("SessionRotation")
  revokedAt         DateTime?
  revokedReason     SessionRevokeReason?
  createdAt         DateTime             @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// ---------- Shared taxonomy infra (used by future content domains; not wired to TradePost) ----------

model Category {
  id          String     @id @default(uuid())
  domain      String
  slug        String
  name        String
  description String?
  icon        String?
  parentId    String?
  parent      Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryParent")
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  @@unique([domain, slug])
  @@index([domain, isActive, sortOrder])
}

// ---------- Media ----------

model Media {
  id              String               @id @default(uuid())
  // Nullable because feedback-ticket attachments are uploaded anonymously
  // (no logged-in user) — every other upload path still sets it.
  ownerId         String?
  owner           User?                @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  storageProvider MediaStorageProvider @default(LOCAL)
  storageKey      String               @unique
  originalUrl     String
  thumbnailUrl    String?
  mimeType        String
  size            Int
  width           Int?
  height          Int?
  checksum        String
  resourceType    MediaResourceType?
  resourceId      String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?

  tradePostImages              TradePostImage[]
  tradeReviewImages            TradeReviewImage[]
  contentReviewImages          ContentReviewImage[]
  businessApplicationDocuments BusinessApplicationDocument[]
  temples                      Temple[]
  specialties                  Specialty[]
  specialtyImages              SpecialtyImage[]
  historicalSites              HistoricalSite[]
  historicalSiteImages         HistoricalSiteImage[]
  agricultureItems             AgricultureItem[]
  agricultureItemImages        AgricultureItemImage[]
  ocopProducts                 OcopProduct[]
  craftVillages                CraftVillage[]
  craftVillageImages           CraftVillageImage[]
  cuisineItems                 CuisineItem[]
  cuisineItemImages            CuisineItemImage[]
  festivals                    Festival[]
  festivalImages               FestivalImage[]
  experienceTours              ExperienceTour[]
  experienceTourImages         ExperienceTourImage[]
  feedbackChannels             FeedbackChannel[]
  mapPlaces                    MapPlace[]
  contacts                     Contact[]
  contactImages                ContactImage[]
  newsArticles                 NewsArticle[]
  newsArticleImages            NewsArticleImage[]
  feedbackTicketMedia          FeedbackTicketMedia[]
  feedbackMessageMedia         FeedbackMessageMedia[]

  @@index([ownerId])
  @@index([resourceType, resourceId])
  @@index([checksum])
}

// ---------- Tourist points: temples / pagodas / shrines ----------

model Temple {
  id            String     @id
  name          String     @db.VarChar(150)
  type          TempleType
  address       String     @db.VarChar(255)
  googleMapsUrl String     @default("") @db.VarChar(2048)
  openHours     String     @db.VarChar(100)
  summary       String     @db.VarChar(300)
  description   Json
  mediaId       String?
  imageAlt      String     @default("") @db.VarChar(150)
  sortOrder     Int        @default(0)
  isActive      Boolean    @default(true)
  version       Int        @default(1)
  createdById   String?
  updatedById   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  media     Media?        @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  createdBy User?         @relation("TempleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?         @relation("TempleUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  events    TempleEvent[]

  @@index([isActive, sortOrder, createdAt])
  @@index([type, isActive, sortOrder])
  @@index([name])
}

model TempleEvent {
  id        String   @id @default(uuid())
  templeId  String
  time      String   @db.VarChar(50)
  name      String   @db.VarChar(150)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  temple Temple @relation(fields: [templeId], references: [id], onDelete: Cascade)

  @@index([templeId, sortOrder])
}

// ---------- Specialties: local food / fruit / gift products ----------

model Specialty {
  id            String            @id
  name          String            @db.VarChar(150)
  category      SpecialtyCategory
  price         String            @db.VarChar(100)
  season        String            @db.VarChar(100)
  summary       String            @db.VarChar(300)
  description   Json
  buyPlaces     Json
  // Kept for migration compatibility; per-place links live in buyPlaces JSON.
  googleMapsUrl String            @default("") @db.VarChar(2048)
  mediaId       String?
  imageAlt      String            @default("") @db.VarChar(150)
  sortOrder     Int               @default(0)
  isActive      Boolean           @default(true)
  version       Int               @default(1)
  createdById   String?
  updatedById   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  media         Media?           @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  galleryImages SpecialtyImage[]
  createdBy     User?            @relation("SpecialtyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?            @relation("SpecialtyUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder, createdAt])
  @@index([category, isActive, sortOrder])
  @@index([name])
  @@index([deletedAt])
}

model SpecialtyImage {
  id          String    @id @default(uuid())
  specialtyId String
  specialty   Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  mediaId     String
  media       Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@unique([specialtyId, mediaId])
  @@index([specialtyId, sortOrder])
}

// ---------- Historical sites: di tích lịch sử ----------

model HistoricalSite {
  id             String             @id
  name           String             @db.VarChar(150)
  rank           HistoricalSiteRank
  address        String             @db.VarChar(255)
  googleMapsUrl  String             @default("") @db.VarChar(2048)
  recognizedYear Int?
  summary        String             @db.VarChar(300)
  history        Json
  highlights     Json
  mediaId        String?
  imageAlt       String             @default("") @db.VarChar(150)
  sortOrder      Int                @default(0)
  isActive       Boolean            @default(true)
  version        Int                @default(1)
  createdById    String?
  updatedById    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  media         Media?                @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  galleryImages HistoricalSiteImage[]
  createdBy     User?                 @relation("HistoricalSiteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?                 @relation("HistoricalSiteUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder, createdAt])
  @@index([rank, isActive, sortOrder])
  @@index([name])
}

model HistoricalSiteImage {
  id               String         @id @default(uuid())
  historicalSiteId String
  historicalSite   HistoricalSite @relation(fields: [historicalSiteId], references: [id], onDelete: Cascade)
  mediaId          String
  media            Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())

  @@unique([historicalSiteId, mediaId])
  @@index([historicalSiteId, sortOrder])
}

// ---------- Agriculture: nông nghiệp ----------

model AgricultureItem {
  id            String              @id
  name          String              @db.VarChar(150)
  category      AgricultureCategory
  location      String              @db.VarChar(255)
  googleMapsUrl String              @default("") @db.VarChar(2048)
  season        String              @db.VarChar(150)
  scale         String              @db.VarChar(150)
  summary       String              @db.VarChar(300)
  description   Json
  highlights    Json
  support       String              @db.VarChar(2000)
  mediaId       String?
  imageAlt      String              @default("") @db.VarChar(150)
  sortOrder     Int                 @default(0)
  isActive      Boolean             @default(true)
  version       Int                 @default(1)
  createdById   String?
  updatedById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  media         Media?                 @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  galleryImages AgricultureItemImage[]
  createdBy     User?                  @relation("AgricultureItemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?                  @relation("AgricultureItemUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder, createdAt])
  @@index([category, isActive, sortOrder])
  @@index([name])
}

model AgricultureItemImage {
  id                String          @id @default(uuid())
  agricultureItemId String
  agricultureItem   AgricultureItem @relation(fields: [agricultureItemId], references: [id], onDelete: Cascade)
  mediaId           String
  media             Media           @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())

  @@unique([agricultureItemId, mediaId])
  @@index([agricultureItemId, sortOrder])
}

// ---------- OCOP: One Commune One Product ----------

model OcopProduct {
  id            String       @id
  name          String       @db.VarChar(150)
  category      OcopCategory
  rating        OcopRating
  producer      String       @db.VarChar(150)
  address       String       @db.VarChar(255)
  googleMapsUrl String       @default("") @db.VarChar(2048)
  priceRange    String       @db.VarChar(100)
  summary       String       @db.VarChar(300)
  description   Json
  highlights    Json
  contactNote   String       @db.VarChar(2000)
  contactPhone  String?      @db.VarChar(30)
  mediaId       String?
  imageAlt      String       @default("") @db.VarChar(150)
  sortOrder     Int          @default(0)
  isActive      Boolean      @default(true)
  version       Int          @default(1)
  createdById   String?
  updatedById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  media     Media? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  createdBy User?  @relation("OcopProductCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?  @relation("OcopProductUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder, createdAt])
  @@index([category, isActive, sortOrder])
  @@index([rating, isActive, sortOrder])
  @@index([name])
}

// ---------- Craft villages: làng nghề ----------

model CraftVillage {
  id            String               @id
  name          String               @db.VarChar(150)
  category      CraftVillageCategory
  address       String               @db.VarChar(255)
  googleMapsUrl String               @default("") @db.VarChar(2048)
  workingTime   String               @db.VarChar(100)
  mainProducts  String               @db.VarChar(255)
  summary       String               @db.VarChar(300)
  description   Json
  highlights    Json
  visitorNote   String               @db.VarChar(2000)
  mediaId       String?
  imageAlt      String               @default("") @db.VarChar(150)
  sortOrder     Int                  @default(0)
  isActive      Boolean              @default(true)
  version       Int                  @default(1)
  createdById   String?
  updatedById   String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  media         Media?              @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  galleryImages CraftVillageImage[]
  createdBy     User?               @relation("CraftVillageCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?               @relation("CraftVillageUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder, createdAt])
  @@index([category, isActive, sortOrder])
  @@index([name])
}

model CraftVillageImage {
  id             String       @id @default(uuid())
  craftVillageId String
  craftVillage   CraftVillage @relation(fields: [craftVillageId], references: [id], onDelete: Cascade)
  mediaId        String
  media          Media        @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  @@unique([craftVillageId, mediaId])
  @@index([craftVillageId, sortOrder])
}

// ---------- Cuisine: ẩm thực ----------

model CuisineItem {
  id              String          @id
  name            String          @db.VarChar(150)
  category        CuisineCategory
  priceRange      String          @db.VarChar(100)
  bestTime        String          @db.VarChar(100)
  googleMapsUrl   String          @default("") @db.VarChar(2048)
  suggestedPlaces Json
  summary         String          @db.VarChar(300)
  description     Json
  highlights      Json
  tip             String          @db.VarChar(2000)
  contactPhone    String          @default("") @db.VarChar(30)
  menu            Json            @default("[]")
  reviews         Json            @default("[]")
  mediaId         String?
  imageAlt        String          @default("") @db.VarChar(150)
  sortOrder       Int             @default(0)
  isActive        Boolean         @default(true)
  version         Int             @default(1)
  createdById     String?
  updatedById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  media         Media?             @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  galleryImages CuisineItemImage[]
  createdBy     User?              @relation("CuisineItemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?              @relation("CuisineItemUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder, createdAt])
  @@index([category, isActive, sortOrder])
  @@index([name])
}

model CuisineItemImage {
  id            String      @id @default(uuid())
  cuisineItemId String
  cuisineItem   CuisineItem @relation(fields: [cuisineItemId], references: [id], onDelete: Cascade)
  mediaId       String
  media         Media       @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())

  @@unique([cuisineItemId, mediaId])
  @@index([cuisineItemId, sortOrder])
}

// ---------- Festivals: lễ hội ----------

model Festival {
  id            String           @id
  name          String           @db.VarChar(150)
  category      FestivalCategory
  time          String           @db.VarChar(150)
  location      String           @db.VarChar(255)
  googleMapsUrl String           @default("") @db.VarChar(2048)
  scale         String           @db.VarChar(100)
  summary       String           @db.VarChar(300)
  description   Json
  activities    Json
  note          String           @db.VarChar(2000)
  mediaId       String?
  imageAlt      String           @default("") @db.VarChar(150)
  sortOrder     Int              @default(0)
  isActive      Boolean          @default(true)
  version       Int              @default(1)
  createdById   String?
  updatedById   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  media         Media?          @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  galleryImages FestivalImage[]
  createdBy     User?           @relation("FestivalCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?           @relation("FestivalUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder, createdAt])
  @@index([category, isActive, sortOrder])
  @@index([name])
}

model FestivalImage {
  id         String   @id @default(uuid())
  festivalId String
  festival   Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  mediaId    String
  media      Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([festivalId, mediaId])
  @@index([festivalId, sortOrder])
}

model ExperienceTour {
  id            String                 @id
  name          String                 @db.VarChar(150)
  category      ExperienceTourCategory
  duration      String                 @db.VarChar(100)
  startTime     String                 @db.VarChar(100)
  priceRange    String                 @db.VarChar(100)
  meetingPoint  String                 @db.VarChar(255)
  googleMapsUrl String                 @default("") @db.VarChar(2048)
  summary       String                 @db.VarChar(300)
  description   Json
  itinerary     Json
  included      Json
  note          String                 @db.VarChar(2000)
  contactPhone  String?                @db.VarChar(30)
  mediaId       String?
  imageAlt      String                 @default("") @db.VarChar(150)
  sortOrder     Int                    @default(0)
  isActive      Boolean                @default(true)
  version       Int                    @default(1)
  createdById   String?
  updatedById   String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  media         Media?                @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  galleryImages ExperienceTourImage[]
  createdBy     User?                 @relation("ExperienceTourCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?                 @relation("ExperienceTourUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder, createdAt])
  @@index([category, isActive, sortOrder])
  @@index([name])
}

model ExperienceTourImage {
  id               String         @id @default(uuid())
  experienceTourId String
  experienceTour   ExperienceTour @relation(fields: [experienceTourId], references: [id], onDelete: Cascade)
  mediaId          String
  media            Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())

  @@unique([experienceTourId, mediaId])
  @@index([experienceTourId, sortOrder])
}

// ---------- Phản hồi ----------

model FeedbackChannel {
  id           String                  @id
  title        String                  @db.VarChar(200)
  category     FeedbackChannelCategory
  responseTime String                  @db.VarChar(150)
  requiredInfo Json
  summary      String                  @db.VarChar(300)
  description  Json
  examples     Json
  note         String                  @db.VarChar(2000)
  mediaId      String?
  imageAlt     String                  @default("") @db.VarChar(150)
  sortOrder    Int                     @default(0)
  isActive     Boolean                 @default(true)
  version      Int                     @default(1)
  createdById  String?
  updatedById  String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  media     Media?           @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  createdBy User?            @relation("FeedbackChannelCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?            @relation("FeedbackChannelUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  tickets   FeedbackTicket[]

  @@index([isActive, sortOrder, createdAt])
  @@index([category, isActive, sortOrder])
  @@index([title])
}

model FeedbackTicket {
  id            String                    @id @default(uuid())
  ticketCode    String                    @unique
  channelId     String?
  fullName      String                    @db.VarChar(150)
  phone         String                    @db.VarChar(30)
  content       String                    @db.VarChar(5000)
  status        FeedbackTicketStatus      @default(NEW)
  adminNote     String?                   @db.VarChar(2000)
  handledById   String?
  submittedById String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  resolvedAt    DateTime?
  readStates    FeedbackTicketReadState[]
  channel       FeedbackChannel?          @relation(fields: [channelId], references: [id], onDelete: SetNull)
  handledBy     User?                     @relation("FeedbackTicketHandler", fields: [handledById], references: [id], onDelete: SetNull)
  submittedBy   User?                     @relation("FeedbackTicketSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  media         FeedbackTicketMedia[]
  messages      FeedbackMessage[]

  @@index([status, createdAt])
  @@index([channelId])
  @@index([phone])
  @@index([submittedById, createdAt])
}

// Attachments (photos/videos) a citizen submits along with a feedback ticket.
// Media rows are uploaded anonymously (no ownerId) and claimed by setting
// resourceType=FEEDBACK_TICKET/resourceId=ticket.id at submit time — same
// unclaimed-then-claimed pattern used for BusinessApplicationDocument.
model FeedbackTicketMedia {
  id        String         @id @default(uuid())
  ticketId  String
  ticket    FeedbackTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())

  @@unique([ticketId, mediaId])
  @@index([ticketId, sortOrder])
}

// Immutable two-way conversation between the feedback sender and admins.
// Anonymous senders have senderUserId=null; access remains protected by the
// ticketCode + phone pair used by the ticket lookup API.
model FeedbackMessage {
  id           String                    @id @default(uuid())
  ticketId     String
  ticket       FeedbackTicket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderRole   FeedbackMessageSenderRole
  senderUserId String?
  senderUser   User?                     @relation("FeedbackMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  // 5000 preserves legacy ticket content when it becomes the first message;
  // new replies are restricted to 2000 by ReplyFeedbackTicketDto.
  content      String                    @default("") @db.VarChar(5000)
  createdAt    DateTime                  @default(now())
  media        FeedbackMessageMedia[]

  @@index([ticketId, createdAt])
  @@index([senderUserId])
}

model FeedbackMessageMedia {
  id        String          @id @default(uuid())
  messageId String
  message   FeedbackMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media           @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())

  @@unique([messageId, mediaId])
  @@index([messageId, sortOrder])
}

// ---------- Bản đồ ----------

model MapPlace {
  id                 String           @id
  name               String           @db.VarChar(150)
  category           MapPlaceCategory
  address            String           @db.VarChar(255)
  googleMapsUrl      String           @default("") @db.VarChar(2048)
  lat                Decimal          @db.Decimal(9, 6)
  lng                Decimal          @db.Decimal(9, 6)
  openTime           String           @db.VarChar(150)
  distanceFromCenter String           @db.VarChar(100)
  summary            String           @db.VarChar(300)
  description        Json
  highlights         Json
  directionNote      String           @db.VarChar(2000)
  mediaId            String?
  imageAlt           String           @default("") @db.VarChar(150)
  sortOrder          Int              @default(0)
  isActive           Boolean          @default(true)
  version            Int              @default(1)
  createdById        String?
  updatedById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  media     Media? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  createdBy User?  @relation("MapPlaceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?  @relation("MapPlaceUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder, createdAt])
  @@index([category, isActive, sortOrder])
  @@index([name])
}

// Durable map-location cache and work queue. Associations are polymorphic so
// cuisine suggested places can use their stable child id without rewriting the
// parent JSON from a background worker.
model MapLocationResolution {
  id            String            @id @default(uuid())
  source        MapLocationSource
  sourceId      String            @db.VarChar(191)
  subId         String            @default("") @db.VarChar(191)
  googleMapsUrl String            @db.VarChar(2048)
  urlHash       String            @db.Char(64)
  status        MapLocationStatus @default(PENDING)
  lat           Decimal?          @db.Decimal(10, 7)
  lng           Decimal?          @db.Decimal(10, 7)
  resolvedAt    DateTime?
  reasonCode    String?           @db.VarChar(64)
  attemptCount  Int               @default(0)
  nextAttemptAt DateTime          @default(now())
  lockedAt      DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([source, sourceId, subId])
  @@index([status, nextAttemptAt, lockedAt])
  @@index([source, sourceId])
}

// ---------- Liên hệ ----------

model Contact {
  id            String          @id
  name          String          @db.VarChar(150)
  category      ContactCategory
  role          String          @db.VarChar(255)
  phone         String          @db.VarChar(30)
  email         String?         @db.VarChar(255)
  address       String          @db.VarChar(255)
  googleMapsUrl String          @default("") @db.VarChar(2048)
  workingTime   String          @db.VarChar(150)
  summary       String          @db.VarChar(300)
  description   Json
  supportTopics Json
  note          String          @db.VarChar(2000)
  mediaId       String?
  imageAlt      String          @default("") @db.VarChar(150)
  sortOrder     Int             @default(0)
  isActive      Boolean         @default(true)
  version       Int             @default(1)
  createdById   String?
  updatedById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  media         Media?         @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  galleryImages ContactImage[]
  createdBy     User?          @relation("ContactCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?          @relation("ContactUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder, createdAt])
  @@index([category, isActive, sortOrder])
  @@index([name])
}

model ContactImage {
  id        String   @id @default(uuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([contactId, mediaId])
  @@index([contactId, sortOrder])
}

// ---------- Tin tức ----------

model NewsArticle {
  id            String       @id
  title         String       @db.VarChar(200)
  category      NewsCategory
  publishedAt   DateTime
  author        String       @db.VarChar(150)
  summary       String       @db.VarChar(300)
  content       Json
  tags          Json
  relatedLinks  Json
  googleMapsUrl String       @default("") @db.VarChar(2048)
  mediaId       String?
  imageAlt      String       @default("") @db.VarChar(150)
  isActive      Boolean      @default(true)
  version       Int          @default(1)
  createdById   String?
  updatedById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  media         Media?             @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  galleryImages NewsArticleImage[]
  createdBy     User?              @relation("NewsArticleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?              @relation("NewsArticleUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isActive, publishedAt])
  @@index([category, isActive, publishedAt])
  @@index([title])
}

model NewsArticleImage {
  id            String      @id @default(uuid())
  newsArticleId String
  newsArticle   NewsArticle @relation(fields: [newsArticleId], references: [id], onDelete: Cascade)
  mediaId       String
  media         Media       @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())

  @@unique([newsArticleId, mediaId])
  @@index([newsArticleId, sortOrder])
}

// ---------- Business registration ----------

model BusinessApplication {
  id                  String                    @id @default(uuid())
  applicantType       BusinessApplicantType
  businessType        BusinessType              @default(GENERAL)
  businessName        String
  businessCategory    String
  // Type-specific details (see business-type.config.ts for which apply).
  templeName          String?
  openingHours        String?
  seatingCapacity     Int?
  roomCount           Int?
  gardenArea          String?
  mainProducts        String?
  contactName         String
  contactPhone        String
  contactEmail        String
  address             String
  identityNumber      String?
  identityIssuedAt    DateTime?
  identityIssuedPlace String?
  legalName           String?
  taxCode             String?
  representativeName  String?
  representativeTitle String?
  website             String?
  description         String?
  zaloId              String?
  zaloDisplayName     String?
  zaloAvatarUrl       String?
  status              BusinessApplicationStatus @default(PENDING)
  rejectionReason     String?
  submittedById       String?
  reviewedById        String?
  reviewedAt          DateTime?
  createdUserId       String?                   @unique
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  submittedBy User?                         @relation("BusinessApplicationSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy  User?                         @relation("BusinessApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdUser User?                         @relation("BusinessApplicationAccount", fields: [createdUserId], references: [id], onDelete: SetNull)
  documents   BusinessApplicationDocument[]

  @@index([status, createdAt])
  @@index([applicantType])
  @@index([businessType])
  @@index([contactEmail])
  @@index([taxCode])
  @@index([submittedById, createdAt])
  @@index([zaloId, createdAt])
}

model BusinessApplicationDocument {
  id            String               @id @default(uuid())
  applicationId String
  type          BusinessDocumentType
  name          String
  mediaId       String
  createdAt     DateTime             @default(now())

  application BusinessApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  media       Media               @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([applicationId, mediaId])
  @@index([applicationId])
}

// ---------- About page CMS ----------

model AboutPage {
  id                String    @id @default("about")
  draftSnapshot     Json
  publishedSnapshot Json?
  version           Int       @default(1)
  publishedVersion  Int       @default(0)
  createdById       String?
  updatedById       String?
  publishedById     String?
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  createdBy   User?           @relation("AboutPageCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?           @relation("AboutPageUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  publishedBy User?           @relation("AboutPagePublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  revisions   AboutRevision[]
}

model AboutRevision {
  id            String   @id @default(uuid())
  aboutPageId   String
  version       Int
  snapshot      Json
  publishedById String?
  publishedAt   DateTime @default(now())

  aboutPage   AboutPage @relation(fields: [aboutPageId], references: [id], onDelete: Cascade)
  publishedBy User?     @relation("AboutRevisionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([aboutPageId, version])
  @@index([aboutPageId, publishedAt])
}

// ---------- TradePost ----------

model TradePostCategory {
  id                       String    @id @default(uuid())
  code                     String    @unique @db.VarChar(50)
  name                     String    @db.VarChar(120)
  description              String?   @db.VarChar(300)
  sortOrder                Int       @default(0)
  isActive                 Boolean   @default(true)
  requiresPromotionDetails Boolean   @default(false)
  version                  Int       @default(1)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?
  createdById              String?
  updatedById              String?

  posts     TradePost[]
  createdBy User?       @relation("TradePostCategoryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?       @relation("TradePostCategoryUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder])
  @@index([deletedAt])
}

model TradePost {
  id               String              @id @default(uuid())
  slug             String              @unique
  ownerId          String
  owner            User                @relation("TradePostOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  categoryId       String
  category         TradePostCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title            String
  summary          String
  description      String
  purpose          TradePostPurpose    @default(COMMERCIAL)
  // Null for NON_PROFIT posts, required for COMMERCIAL ones.
  priceType        TradePostPriceType?
  price            Decimal?            @db.Decimal(14, 2)
  priceLabel       String?
  address          String
  lat              Decimal?            @db.Decimal(9, 6)
  lng              Decimal?            @db.Decimal(9, 6)
  contactName      String
  contactPhone     String
  contactZalo      String?
  thumbnailUrl     String?
  status           TradePostStatus     @default(DRAFT)
  featured         Boolean             @default(false)
  promotionPercent Int?
  promotionStartAt DateTime?
  promotionEndAt   DateTime?
  // NON_PROFIT only: when the promoted event (e.g. a temple festival) runs.
  // Without an explicit expiresAt the post stops being public at eventEndAt.
  eventStartAt     DateTime?
  eventEndAt       DateTime?
  expiresAt        DateTime?
  viewCount        Int                 @default(0)
  saveCount        Int                 @default(0)
  averageRating    Decimal             @default(0) @db.Decimal(2, 1)
  reviewCount      Int                 @default(0)
  publishedAt      DateTime?
  rejectedReason   String?
  approvedById     String?
  approvedBy       User?               @relation("TradePostApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?

  images        TradePostImage[]
  reviews       TradeReview[]
  events        TradePostEvent[]
  savedBy       SavedTradePost[]
  conversations TradeConversation[]

  @@index([status, publishedAt])
  @@index([ownerId])
  @@index([categoryId])
  @@index([featured])
  @@index([purpose])
}

model TradePostImage {
  id          String    @id @default(uuid())
  tradePostId String
  tradePost   TradePost @relation(fields: [tradePostId], references: [id], onDelete: Cascade)
  mediaId     String
  media       Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@unique([tradePostId, mediaId])
  @@index([tradePostId, sortOrder])
}

// ---------- TradeReview ----------

model TradeReview {
  id           String            @id @default(uuid())
  tradePostId  String
  tradePost    TradePost         @relation(fields: [tradePostId], references: [id], onDelete: Cascade)
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  rating       Int
  content      String            @db.VarChar(500)
  status       TradeReviewStatus @default(PUBLISHED)
  // Seller's public reply (the post owner); never edits the customer's content.
  replyContent String?           @db.VarChar(500)
  repliedAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  images TradeReviewImage[]

  // True "one active review per user per post" is enforced via a hand-written
  // Postgres partial unique index (see migrations) — Prisma's schema DSL
  // cannot express a WHERE-filtered unique constraint. This index exists
  // for query-planning only.
  @@index([tradePostId, userId])
  @@index([tradePostId, status])
  @@index([userId])
}

model TradeReviewImage {
  id            String      @id @default(uuid())
  tradeReviewId String
  tradeReview   TradeReview @relation(fields: [tradeReviewId], references: [id], onDelete: Cascade)
  mediaId       String
  media         Media       @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())

  @@unique([tradeReviewId, mediaId])
}

// ---------- Content reviews (đánh giá điểm đến / nội dung địa phương) ----------

// Star rating + comment a mini app user leaves on a content item (temple,
// specialty, festival, ...). Polymorphic like MapLocationResolution: targetId
// is the item's slug id within targetType, so there is no FK — the service
// checks the target exists and is visible, and each section's remove() purges
// its reviews (slugs can be reused by a later item).
model ContentReview {
  id           String                  @id @default(uuid())
  targetType   ContentReviewTargetType
  targetId     String
  userId       String
  user         User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  rating       Int
  content      String                  @db.VarChar(1000)
  status       ContentReviewStatus     @default(PUBLISHED)
  // Official public reply from the admin team; never edits the user's content.
  replyContent String?                 @db.VarChar(1000)
  repliedAt    DateTime?
  repliedById  String?
  repliedBy    User?                   @relation("ContentReviewReplier", fields: [repliedById], references: [id], onDelete: SetNull)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  deletedAt    DateTime?

  images ContentReviewImage[]

  // "One active review per user per item" is a hand-written partial unique
  // index (see migrations), same as TradeReview.
  @@index([targetType, targetId, status, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ContentReviewImage {
  id              String        @id @default(uuid())
  contentReviewId String
  contentReview   ContentReview @relation(fields: [contentReviewId], references: [id], onDelete: Cascade)
  mediaId         String
  media           Media         @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())

  @@unique([contentReviewId, mediaId])
  @@index([mediaId])
}

// ---------- Notifications (mini app bell) ----------

// One row per recipient. Broadcasts (e.g. a newly published trade post) are
// fanned out on write so read state stays per user. `type` is a plain string
// so new kinds need no migration — see notification-types.ts.
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    @db.VarChar(64)
  title     String    @db.VarChar(200)
  body      String    @db.VarChar(500)
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// ---------- Trade chat (customer <-> post owner) ----------

// One thread per (post, customer). ownerId is denormalized from the post so
// the owner's inbox is a single indexed query.
model TradeConversation {
  id            String         @id @default(uuid())
  tradePostId   String
  tradePost     TradePost      @relation(fields: [tradePostId], references: [id], onDelete: Cascade)

  customerId    String
  customer      User           @relation("TradeConversationCustomer", fields: [customerId], references: [id], onDelete: Cascade)

  ownerId       String
  owner         User           @relation("TradeConversationOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  lastMessageAt DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Admin xóa mềm hội thoại
  deletedAt     DateTime?

  messages      TradeMessage[]

  @@unique([tradePostId, customerId])
  @@index([ownerId, lastMessageAt])
  @@index([customerId, lastMessageAt])
  @@index([deletedAt])
}

model TradeMessage {
  id             String            @id @default(uuid())
  conversationId String
  conversation   TradeConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User              @relation("TradeMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  content        String            @db.VarChar(1000)
  readAt         DateTime?
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
  @@index([conversationId, senderId, readAt])
}

// ---------- Trade analytics / engagement ----------

// Append-only engagement log: one row per view/interaction. Powers the
// business & admin analytics dashboards (traffic over time, unique visitors,
// interaction breakdown). Denormalized counters (TradePost.viewCount /
// saveCount) stay for cheap list-sort/display; this table is the source of
// truth for anything time-bucketed or de-duplicated.
model TradePostEvent {
  id          String             @id @default(uuid())
  tradePostId String
  tradePost   TradePost          @relation(fields: [tradePostId], references: [id], onDelete: Cascade)
  type        TradePostEventType
  // Logged-in actor (null for anonymous visitors). SetNull so purging a user
  // never destroys historical aggregates.
  userId      String?
  user        User?              @relation("TradePostEventUser", fields: [userId], references: [id], onDelete: SetNull)
  // SHA-256 hex of (secret + ip + userAgent) — approximates a unique
  // anonymous visitor without ever persisting the raw IP.
  visitorHash String?            @db.VarChar(64)
  createdAt   DateTime           @default(now())

  @@index([tradePostId, type, createdAt])
  @@index([tradePostId, createdAt])
  @@index([createdAt])
}

// Source of truth for "saved / bookmarked" state and the user's saved list.
// A save also emits a TradePostEvent(SAVE) so the analytics timeline can chart
// saves per day.
model SavedTradePost {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradePostId String
  tradePost   TradePost @relation(fields: [tradePostId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userId, tradePostId])
  @@index([tradePostId])
  @@index([userId, createdAt])
}

// ---------- Audit ----------

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action       String
  resourceType String
  resourceId   String?
  oldData      Json?
  newData      Json?
  ipAddress    String?
  userAgent    String?
  requestId    String?
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([actorId])
  @@index([createdAt])
  @@index([action])
}

model FeedbackTicketReadState {
  id         Int      @id @default(autoincrement())
  ticketId   String
  reader     String
  lastReadAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ticket FeedbackTicket @relation(
    fields: [ticketId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([ticketId, reader])
  @@index([ticketId])
}

// ---------- Garden harvest traceability ----------

// A harvested lot a garden owner (BUSINESS account, businessType GARDEN)
// declares from the desktop seller center. The printed QR label links to the
// public page for `code`; every field is self-declared by the owner.
model HarvestBatch {
  id          String    @id @default(uuid())
  // Short public code encoded in the QR label (no 0/O/1/I to read it aloud).
  code        String    @unique @db.VarChar(16)
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  // Name printed as "Tên chủ vườn" — snapshot, so later account renames don't
  // change labels already in circulation.
  ownerName   String    @db.VarChar(120)
  fruitName   String    @db.VarChar(120)
  harvestDate DateTime  @db.Date
  weightKg    Decimal   @db.Decimal(10, 2)
  pricePerKg  Decimal   @db.Decimal(14, 0)
  fertilizers String    @db.VarChar(2000)
  pesticides  String    @db.VarChar(2000)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([ownerId, harvestDate])
}
